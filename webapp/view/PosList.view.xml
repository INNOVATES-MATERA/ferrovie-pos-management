<mvc:View controllerName="posmanagement.controller.PosList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <f:DynamicPage showFooter="false"
        class="pagePosList">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>lblPosManagement}"/>
                </f:heading>
                <f:actions>
                    <Button text="{i18n>btnNewPos}"
                        type="Emphasized"
                        icon="sap-icon://add"
                        press=".onNewPos"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>

                <!-- TABELLA POS -->
                <Panel class="sapUiTinyMarginTop">
                    <headerToolbar>
                        <OverflowToolbar style="Standard">
                            <Title text="{i18n>lblPosTable} ({Pos>/count})"
                                level="H2"/>
                            <ToolbarSpacer/>
                            <SearchField search=".onSearch"
                                width="24rem"/>
                            <Button icon="sap-icon://action-settings"
                                press=".onSettings"
                                tooltip="{i18n>btnSettings}"
                                app:panel="Columns"/>
                            <Button icon="sap-icon://download"
                                press=".onDownload"
                                tooltip="{i18n>btnDownload}"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <Table id="tblPos"
                        items="{path: '/PosTestataSet', parameters: {$count: true}}"
                        mode="None"
                        fixedLayout="true"
                        alternateRowColors="true"
                        sticky="ColumnHeaders"
                        growing="true"
                        growingThreshold="10">

                        <columns>

                            <Column app:p13nKey="idPos"
                                width="8rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblPosId}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="contratto"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lblContractCode}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="impresaAppaltatrice"
                                width="15rem">
                                <header>
                                    <Label text="{i18n>lblContractorCompany}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="ruoloImpresa"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lblCompanyRole}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="statoPos"
                                width="8rem">
                                <header>
                                    <Label text="{i18n>lblPosStatus}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="datoreLavoro"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblEmployer}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="rspp"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblRspp}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="rls"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblRls}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="medicocompetente"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblMedicoCompetente}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="direttoreCantiere"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblWorksDirectorSite}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="direttoreTecnico"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblSiteManager}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="revisione"
                                app:searchable="false"
                                width="6rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblRevision}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="dataRedazione"
                                app:searchable="false"
                                width="9rem">
                                <header>
                                    <Label text="{i18n>lblDraftDate}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="dataRicezioneCruscotto"
                                app:searchable="false"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblReceptionDate}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="linkCde"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lblLink}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column width="2.5rem"
                                hAlign="Center">
                                <header>
                                    <Text text=""/>
                                </header>
                            </Column>

                        </columns>

                        <items>
                            <ColumnListItem press=".onDetail"
                                type="Navigation">
                                <cells>
                                    <Text text="{idPos}"
                                        wrapping="false"/>
                                    <Text text="{contratto}"
                                        wrapping="false"/>
                                    <Text text="{impresaAppaltatrice}"
                                        wrapping="false"/>
                                    <Text text="{ruoloImpresa}"
                                        wrapping="false"/>
                                    <ObjectStatus text="{statoPos}"
                                        state="{= ${statoPos} === 'Valido' ? 'Success' : ${statoPos} === 'Scaduto' ? 'Error' : ${statoPos} === 'Superato' ? 'Warning' : 'None' }"/>
                                    <Text text="{datoreLavoro}"
                                        wrapping="false"/>
                                    <Text text="{rspp}"
                                        wrapping="false"/>
                                    <Text text="{rls}"
                                        wrapping="false"/>
                                    <Text text="{medicocompetente}"
                                        wrapping="false"/>
                                    <Text text="{direttoreCantiere}"
                                        wrapping="false"/>
                                    <Text text="{direttoreTecnico}"
                                        wrapping="false"/>
                                    <Text text="{revisione}"
                                        wrapping="false"/>
                                    <Text core:require="{ ODataDate: 'sap/ui/model/odata/type/Date' }"
                                        text="{path: 'dataRedazione', type: 'ODataDate', formatOptions: {style: 'short', pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text core:require="{ ODataDateTimeOffset: 'sap/ui/model/odata/type/DateTimeOffset' }"
                                        text="{path: 'dataRicezioneCruscotto', type: 'ODataDateTimeOffset', formatOptions: {pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text text="{linkCde}"
                                        wrapping="false"/>
                                    <Button icon="sap-icon://delete"
                                        tooltip="{i18n>btnDelete}"
                                        type="Transparent"
                                        press=".onDelete"/>
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </Panel>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
