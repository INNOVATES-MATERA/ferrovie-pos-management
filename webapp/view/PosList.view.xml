<mvc:View controllerName="posmanagement.controller.PosList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <f:DynamicPage showFooter="false" class="pagePosList">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>lbl_pos_management}"/>
                </f:heading>
                <f:actions>
                    <Button text="{i18n>btn_new_pos}"
                        type="Emphasized"
                        icon="sap-icon://add"
                        press="onNewPos"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>

                <!-- TABELLA POS -->
                <Panel class="sapUiTinyMarginTop tablePanelContent">
                    <headerToolbar>
                        <OverflowToolbar style="Standard">
                            <Title text="{i18n>lbl_pos_table} ({Pos>/count})"
                                level="H2"/>
                            <SearchField search="onSearch"
                                width="16rem"/>
                            <ToolbarSpacer/>
                            <Button icon="sap-icon://delete"
                                text="{i18n>btn_delete}"
                                press="onDelete"/>
                            <Button id="btnPosListReset"
                                icon="sap-icon://refresh"
                                press="onReset"
                                tooltip="{i18n>btn_reset}"/>
                            <!-- Sort/Filter di default nascosti: il sort avviene cliccando l'header colonna
                                 (onColumnSort), il filtro tramite il SearchField sopra. -->
                            <!--<Button icon="sap-icon://sort"
                                press="onSettings"
                                tooltip="{i18n>btn_sort}"
                                app:panel="Sorter">
                                <customData>
                                    <BadgeCustomData value="{Pos>/sortCount}"/>
                                </customData>
                            </Button>
                            <Button icon="sap-icon://filter"
                                press="onSettings"
                                app:panel="Filter">
                                <customData>
                                    <BadgeCustomData value="{Pos>/filterCount}"/>
                                </customData>
                            </Button>-->
                            <Button icon="sap-icon://action-settings"
                                press="onSettings"
                                app:panel="Columns"/>
                            <Button icon="sap-icon://download"
                                press="onDownload"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <Table id="tblPos"
                        items="{path: '/PosTestataSet', parameters: {$count: true}}"
                        mode="MultiSelect"
                        fixedLayout="true"
                        growing="true"
                        growingThreshold="10"
                        class="posTable">

                        <columns>

                            <Column app:p13nKey="idPos"
                                width="8rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_pos_id}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="idPos"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="contratto"
                                width="10rem">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_contract_code}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="contratto"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="impresaAppaltatrice"
                                width="15rem">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_contractor_company}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="impresaAppaltatrice"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="ruoloImpresa"
                                width="10rem">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_company_role}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="ruoloImpresa"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="statoPos"
                                width="8rem">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_pos_status}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="statoPos"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="datoreLavoro"
                                width="12rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_employer}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="datoreLavoro"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="rspp"
                                width="10rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_rspp}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="rspp"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="rls"
                                width="10rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_rls}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="rls"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="medicocompetente"
                                width="12rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_medico_competente}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="medicocompetente"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="direttoreCantiere"
                                width="12rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_works_director_site}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="direttoreCantiere"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="direttoreTecnico"
                                width="10rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_site_manager}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="direttoreTecnico"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="revisione"
                                app:searchable="false"
                                width="6rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_revision}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="revisione"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="dataRedazione"
                                app:searchable="false"
                                width="9rem">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_draft_date}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="dataRedazione"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="dataRicezioneCruscotto"
                                app:searchable="false"
                                width="10rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_reception_date}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="dataRicezioneCruscotto"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>

                            <Column app:p13nKey="linkCde"
                                width="12rem"
                                visible="false">
                                <header>
                                    <HBox alignItems="Center" class="sortableColumnHeader">
                                        <Link text="{i18n>lbl_link}" press="onColumnSort" class="sortableColumnHeaderLink">
                                            <customData>
                                                <core:CustomData key="sortKey" value="linkCde"/>
                                            </customData>
                                        </Link>
                                        <core:Icon src="sap-icon://sort" class="sapUiTinyMarginBegin sortIcon" size="0.85rem" visible="false"/>
                                    </HBox>
                                </header>
                            </Column>


                        </columns>

                        <items>
                            <ColumnListItem press="onDetail"
                                type="Navigation">
                                <cells>
                                    <Text text="{idPos}"
                                        wrapping="false"/>
                                    <Text text="{contratto}"
                                        wrapping="false"/>
                                    <Text text="{impresaAppaltatrice}"
                                        wrapping="false"/>
                                    <Text text="{ruoloImpresa}"
                                        wrapping="false"/>
                                    <ObjectStatus text="{statoPos}" class="posStatusBadge">
                                        <customData>
                                            <core:CustomData key="stato" value="{statoPos}" writeToDom="true"/>
                                        </customData>
                                    </ObjectStatus>
                                    <Text text="{datoreLavoro}"
                                        wrapping="false"/>
                                    <Text text="{rspp}"
                                        wrapping="false"/>
                                    <Text text="{rls}"
                                        wrapping="false"/>
                                    <Text text="{medicocompetente}"
                                        wrapping="false"/>
                                    <Text text="{direttoreCantiere}"
                                        wrapping="false"/>
                                    <Text text="{direttoreTecnico}"
                                        wrapping="false"/>
                                    <Text text="{revisione}"
                                        wrapping="false"/>
                                    <Text text="{path: 'dataRedazione', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'short', pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text text="{path: 'dataRicezioneCruscotto', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text text="{linkCde}"
                                        wrapping="false"/>
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </Panel>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
