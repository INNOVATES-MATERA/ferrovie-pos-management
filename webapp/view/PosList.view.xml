<mvc:View controllerName="posmanagement.controller.PosList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <f:DynamicPage showFooter="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>lbl_pos_management}"/>
                </f:heading>
                <f:actions>
                    <Button text="{i18n>btn_new_pos}"
                        type="Emphasized"
                        icon="sap-icon://add"
                        press="onNewPos"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>

                <!-- TABELLA POS -->
                <Panel class="sapUiTinyMarginTop tablePanelContent">
                    <headerToolbar>
                        <OverflowToolbar style="Standard">
                            <Title text="{i18n>lbl_pos_table} ({Pos>/count})"
                                level="H2"/>
                            <ToolbarSpacer/>
                            <Button icon="sap-icon://delete"
                                text="{i18n>btn_delete}"
                                press="onDelete"/>
                            <Button id="btnPosListReset"
                                icon="sap-icon://refresh"
                                press="onReset"
                                tooltip="{i18n>btn_reset}"/>
                            <Button icon="sap-icon://sort"
                                press="onSettings"
                                tooltip="{i18n>btn_sort}"
                                app:panel="Sorter">
                                <customData>
                                    <BadgeCustomData value="{Pos>/sortCount}"/>
                                </customData>
                            </Button>
                            <Button icon="sap-icon://filter"
                                press="onSettings"
                                app:panel="Filter">
                                <customData>
                                    <BadgeCustomData value="{Pos>/filterCount}"/>
                                </customData>
                            </Button>
                            <Button icon="sap-icon://action-settings"
                                press="onSettings"
                                app:panel="Columns"/>
                            <Button icon="sap-icon://download"
                                press="onDownload"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <Table id="tblPos"
                        items="{path: '/PosTestataSet', parameters: {$count: true}}"
                        mode="MultiSelect"
                        fixedLayout="true"
                        growing="true"
                        growingThreshold="10"
                        class="posTable">

                        <columns>

                            <Column app:p13nKey="idPos"
                                width="8rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_pos_id}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="contratto"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lbl_contract_code}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="impresaAppaltatrice"
                                width="15rem">
                                <header>
                                    <Label text="{i18n>lbl_contractor_company}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="ruoloImpresa"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lbl_company_role}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="statoPos"
                                width="8rem">
                                <header>
                                    <Label text="{i18n>lbl_pos_status}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="datoreLavoro"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_employer}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="rspp"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_rspp}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="rls"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_rls}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="medicocompetente"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_medico_competente}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="direttoreCantiere"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_works_director_site}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="direttoreTecnico"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_site_manager}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="revisione"
                                width="6rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_revision}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="dataRedazione"
                                width="9rem">
                                <header>
                                    <Label text="{i18n>lbl_draft_date}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="dataRicezioneCruscotto"
                                width="10rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_reception_date}"
                                        wrapping="false"/>
                                </header>
                            </Column>

                            <Column app:p13nKey="linkCde"
                                width="12rem"
                                visible="false">
                                <header>
                                    <Label text="{i18n>lbl_link}"
                                        wrapping="false"/>
                                </header>
                            </Column>


                        </columns>

                        <items>
                            <ColumnListItem press="onDetail"
                                type="Navigation">
                                <cells>
                                    <Text text="{idPos}"
                                        wrapping="false"/>
                                    <Text text="{contratto}"
                                        wrapping="false"/>
                                    <Text text="{impresaAppaltatrice}"
                                        wrapping="false"/>
                                    <Text text="{ruoloImpresa}"
                                        wrapping="false"/>
                                    <ObjectStatus text="{statoPos}" class="posStatusBadge">
                                        <customData>
                                            <core:CustomData key="stato" value="{statoPos}" writeToDom="true"/>
                                        </customData>
                                    </ObjectStatus>
                                    <Text text="{datoreLavoro}"
                                        wrapping="false"/>
                                    <Text text="{rspp}"
                                        wrapping="false"/>
                                    <Text text="{rls}"
                                        wrapping="false"/>
                                    <Text text="{medicocompetente}"
                                        wrapping="false"/>
                                    <Text text="{direttoreCantiere}"
                                        wrapping="false"/>
                                    <Text text="{direttoreTecnico}"
                                        wrapping="false"/>
                                    <Text text="{revisione}"
                                        wrapping="false"/>
                                    <Text text="{path: 'dataRedazione', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'short', pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text text="{path: 'dataRicezioneCruscotto', type: 'sap.ui.model.odata.type.DateTimeOffset', formatOptions: {pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text text="{linkCde}"
                                        wrapping="false"/>
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </Panel>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
