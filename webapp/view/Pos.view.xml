<mvc:View controllerName="posmanagement.controller.Pos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:sap.ui.fl="sap.ui.fl">

    <f:DynamicPage showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>lbl_pos_form}"/>
                </f:heading>
                <f:expandedContent>
                    <Title text="{POS>/idPos}"
                        visible="{POS>/isEdit}"
                        level="H3"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Title text="{POS>/idPos}"
                        visible="{POS>/isEdit}"
                        level="H3"/>
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <!-- HEADER PINNABLE: dati testata POS -->
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <form:Form id="frmPosEdit"
                    editable="true">
                    <form:layout>
                        <form:ResponsiveGridLayout labelSpanXL="4"
                            labelSpanL="4"
                            labelSpanM="4"
                            labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="3"
                            columnsL="2"
                            columnsM="1"
                            singleContainerFullSize="false"/>
                    </form:layout>
                    <form:formContainers>

                        <!-- Container 1: Identificatori -->
                        <form:FormContainer>
                            <form:formElements>
                                <form:FormElement label="{i18n>lbl_pos_id}">
                                    <form:fields>
                                        <Input id="inpPosId"
                                            value="{POS>/idPos}"
                                            editable="false"
                                            visible="{POS>/isEdit}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_contract}">
                                    <form:fields>
                                        <Input id="inpContractCode"
                                            value="{POS>/contratto}"
                                            editable="false"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_contractor_company}">
                                    <form:fields>
                                        <Input id="inpContractorCompany"
                                            value="{POS>/impresaAppaltatrice}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_company_role}">
                                    <form:fields>
                                        <Input id="inpCompanyRole"
                                            value="{POS>/ruoloImpresa}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_parent_contract_code}">
                                    <form:fields>
                                        <Input id="inpParentContractCode"
                                            value="{POS>/codiceContrattoSuperiore}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_client}">
                                    <form:fields>
                                        <Input id="inpClient"
                                            value="{POS>/committente}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_employer}">
                                    <form:fields>
                                        <Input id="inpEmployer"
                                            value="{POS>/datoreLavoro}"
                                            required="true"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_rspp}">
                                    <form:fields>
                                        <Input id="inpRspp"
                                            value="{POS>/rspp}"/>
                                    </form:fields>
                                </form:FormElement>
                            </form:formElements>
                        </form:FormContainer>

                        <!-- Container 2: Figure di sicurezza -->
                        <form:FormContainer>
                            <form:formElements>
                                <form:FormElement label="{i18n>lbl_rls}">
                                    <form:fields>
                                        <Input id="inpRls"
                                            value="{POS>/rls}"
                                            required="true"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_medico_competente}">
                                    <form:fields>
                                        <Input id="inpMedicoCompetente"
                                            value="{POS>/medicocompetente}"
                                            required="true"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_works_director}">
                                    <form:fields>
                                        <Input id="inpWorksDirector"
                                            value="{POS>/direttoreLavori}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_works_director_site}">
                                    <form:fields>
                                        <Input id="inpWorksDirectorSite"
                                            value="{POS>/direttoreCantiere}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_site_manager}">
                                    <form:fields>
                                        <Input id="inpSiteManager"
                                            value="{POS>/capocantiere}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_foreman}">
                                    <form:fields>
                                        <Input id="inpForeman"
                                            value="{POS>/preposto}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_first_aid_personnel}">
                                    <form:fields>
                                        <Input id="inpFirstAidPersonnel"
                                            value="{POS>/addettiPrimoSoccorso}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_fire_personnel}">
                                    <form:fields>
                                        <Input id="inpFirePersonnel"
                                            value="{POS>/addettiPrimoAntincendio}"/>
                                    </form:fields>
                                </form:FormElement>
                            </form:formElements>
                        </form:FormContainer>

                        <!-- Container 3: date -->
                        <form:FormContainer>
                            <form:formElements>
                                <form:FormElement label="{i18n>lbl_revision}">
                                    <form:fields>
                                        <Input id="inpRevision"
                                            value="{POS>/revisione}"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_draft_date}">
                                    <form:fields>
                                        <DatePicker id="dpDraftDate"
                                            value="{POS>/dataRedazione}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd/MM/yyyy"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_reception_date}">
                                    <form:fields>
                                        <DatePicker id="dpReceptionDate"
                                            value="{POS>/dataRicezioneCruscotto}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd/MM/yyyy"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_validity_start}">
                                    <form:fields>
                                        <DatePicker id="dpValidityStart"
                                            value="{POS>/inizioValidita}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd/MM/yyyy"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_validity_end}">
                                    <form:fields>
                                        <DatePicker id="dpValidityEnd"
                                            value="{POS>/fineValidita}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd/MM/yyyy"/>
                                    </form:fields>
                                </form:FormElement>
                                <form:FormElement label="{i18n>lbl_link}">
                                    <form:fields>
                                        <Input id="inpLink"
                                            value="{POS>/linkCde}"/>
                                    </form:fields>
                                </form:FormElement>
                            </form:formElements>
                        </form:FormContainer>

                    </form:formContainers>
                </form:Form>
            </f:DynamicPageHeader>
        </f:header>

        <!-- CONTENT: tabella utenti + colonna abilitazioni -->
        <f:content>
            <f:FlexibleColumnLayout id="fclStaff"
                layout="{= ${Skills>/isOpen} ? 'TwoColumnsBeginExpanded' : 'OneColumn' }">

                <!-- Colonna master: tabella utenti -->
                <f:beginColumnPages>
                    <Panel>
                        <OverflowToolbar style="Standard"
                            class="pt-auto-10">
                            <Title text="{i18n>lbl_employees} ({Staff>/count})"
                                level="H2"/>
                            <ToolbarSpacer/>
                            <Button icon="sap-icon://add"
                                text="{i18n>btn_add}"
                                press="onAddStaff"/>
                            <Button icon="sap-icon://delete"
                                text="{i18n>btn_delete}"
                                press="onDeleteStaff"/>
                            <Button id="btnStaffReset"
                                icon="sap-icon://refresh"
                                press="onReset"
                                tooltip="{i18n>btn_reset}"/>
                            <Button icon="sap-icon://sort"
                                press="onSettings"
                                tooltip="{i18n>btn_sort}"
                                app:panel="Sorter">
                                <customData>
                                    <BadgeCustomData value="{Staff>/sortCount}"/>
                                </customData>
                            </Button>
                            <Button icon="sap-icon://filter"
                                press="onSettings"
                                app:panel="Filter">
                                <customData>
                                    <BadgeCustomData value="{Staff>/filterCount}"/>
                                </customData>
                            </Button>
                            <Button icon="sap-icon://action-settings"
                                press="onSettings"
                                app:panel="Columns"/>
                            <Button icon="sap-icon://download"
                                press="onDownload"/>
                        </OverflowToolbar>

                        <ScrollContainer horizontal="true"
                            vertical="false"
                            width="100%">
                            <Table id="tblStaff"
                                items="{Staff>/data}"
                                mode="MultiSelect"
                                fixedLayout="true"
                                class="posTable">

                                <columns>

                                    <Column app:p13nKey="idDipendente"
                                        width="9rem"
                                        visible="false">
                                        <header>
                                            <Label text="{i18n>lbl_employee_id}"
                                                wrapping="false"/>
                                        </header>
                                    </Column>

                                    <Column app:p13nKey="nome"
                                        width="10rem">
                                        <header>
                                            <Label text="{i18n>lbl_first_name}"
                                                wrapping="false"/>
                                        </header>
                                    </Column>

                                    <Column app:p13nKey="cognome"
                                        width="10rem">
                                        <header>
                                            <Label text="{i18n>lbl_last_name}"
                                                wrapping="false"/>
                                        </header>
                                    </Column>

                                    <Column app:p13nKey="reparto"
                                        width="12rem">
                                        <header>
                                            <Label text="{i18n>lbl_department}"
                                                wrapping="false"/>
                                        </header>
                                    </Column>

                                    <Column app:p13nKey="mansione"
                                        width="10rem">
                                        <header>
                                            <Label text="{i18n>lbl_role}"
                                                wrapping="false"/>
                                        </header>
                                    </Column>

                                    <Column width="3.5rem"
                                        hAlign="Center">
                                        <header>
                                            <Label text=""/>
                                        </header>
                                    </Column>

                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{Staff>idDipendente}"
                                                wrapping="false"/>
                                            <Input value="{Staff>nome}"/>
                                            <Input value="{Staff>cognome}"/>
                                            <Input value="{Staff>reparto}"/>
                                            <Input value="{Staff>mansione}"/>
                                            <Button icon="sap-icon://permission"
                                                type="Transparent"
                                                press="onOpenSkills"
                                                tooltip="{i18n>btn_skills}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>

                            </Table>
                        </ScrollContainer>
                    </Panel>
                </f:beginColumnPages>

                <!-- Colonna detail: abilitazioni dipendente -->
                <f:midColumnPages>
                    <Page title="{= ${i18n>lbl_skills} + ' - ' + ${Skills>/nome} + ' ' + ${Skills>/cognome} }"
                        showNavButton="true"
                        navButtonPress="onCloseSkills">
                        <content>
                            <VBox class="skillsPanel">

                                <IconTabBar id="tabSkills"
                                    expanded="true">
                                    <items>

                                        <!-- Tab 1: Abilitazioni Ferroviarie -->
                                        <IconTabFilter text="{i18n>lbl_tab_ferroviaria}"
                                            key="ferroviaria">
                                            <Table id="tblFerroviaria"
                                                items="{path: 'Skills>/items', filters: [{path: 'categoria', operator: 'EQ', value1: 'ferroviaria'}]}"
                                                mode="MultiSelect"
                                                selectionChange="onSkillSelectionChange"
                                                fixedLayout="false">
                                                <columns>
                                                    <Column>
                                                        <header>
                                                            <Label text="{i18n>lbl_skills}"/>
                                                        </header>
                                                    </Column>
                                                    <Column width="10rem">
                                                        <header>
                                                            <Label text="{i18n>lbl_skill_start}"/>
                                                        </header>
                                                    </Column>
                                                    <Column width="10rem">
                                                        <header>
                                                            <Label text="{i18n>lbl_skill_end}"/>
                                                        </header>
                                                    </Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem selected="{Skills>flagAttiva}"
                                                        type="Inactive">
                                                        <cells>
                                                            <Text text="{Skills>descrizione}"
                                                                wrapping="false"/>
                                                            <DatePicker value="{Skills>inizioAbilitazione}"
                                                                valueFormat="yyyy-MM-dd"
                                                                displayFormat="dd/MM/yyyy"
                                                                visible="{Skills>flagAttiva}"
                                                                width="9rem"/>
                                                            <DatePicker value="{Skills>scadenzaAbilitazione}"
                                                                valueFormat="yyyy-MM-dd"
                                                                displayFormat="dd/MM/yyyy"
                                                                visible="{Skills>flagAttiva}"
                                                                width="9rem"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </IconTabFilter>

                                        <!-- Tab 2: Decreto 81/2008 -->
                                        <IconTabFilter text="{i18n>lbl_tab_decreto}"
                                            key="decreto">
                                            <Table id="tblDecreto"
                                                items="{path: 'Skills>/items', filters: [{path: 'categoria', operator: 'EQ', value1: 'decreto'}]}"
                                                mode="MultiSelect"
                                                selectionChange="onSkillSelectionChange"
                                                fixedLayout="false">
                                                <columns>
                                                    <Column>
                                                        <header>
                                                            <Label text="{i18n>lbl_skills}"/>
                                                        </header>
                                                    </Column>
                                                    <Column width="10rem">
                                                        <header>
                                                            <Label text="{i18n>lbl_skill_start}"/>
                                                        </header>
                                                    </Column>
                                                    <Column width="10rem">
                                                        <header>
                                                            <Label text="{i18n>lbl_skill_end}"/>
                                                        </header>
                                                    </Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem selected="{Skills>flagAttiva}"
                                                        type="Inactive">
                                                        <cells>
                                                            <Text text="{Skills>descrizione}"
                                                                wrapping="false"/>
                                                            <DatePicker value="{Skills>inizioAbilitazione}"
                                                                valueFormat="yyyy-MM-dd"
                                                                displayFormat="dd/MM/yyyy"
                                                                visible="{Skills>flagAttiva}"
                                                                width="9rem"/>
                                                            <DatePicker value="{Skills>scadenzaAbilitazione}"
                                                                valueFormat="yyyy-MM-dd"
                                                                displayFormat="dd/MM/yyyy"
                                                                visible="{Skills>flagAttiva}"
                                                                width="9rem"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </IconTabFilter>

                                    </items>
                                </IconTabBar>

                            </VBox>
                        </content>
                    </Page>
                </f:midColumnPages>

            </f:FlexibleColumnLayout>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <Button text="{i18n>btn_back}"
                    type="Back"
                    press="onBack"/>
                <ToolbarSpacer/>
                <Button id="btnSave"
                    text="{i18n>btn_save}"
                    type="Emphasized"
                    icon="sap-icon://save"
                    press="onSave"/>
                <Button id="btnCancel"
                    text="{i18n>btn_cancel}"
                    press="onCancel"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>


</mvc:View>
