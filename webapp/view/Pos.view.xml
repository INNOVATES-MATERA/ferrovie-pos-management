<mvc:View controllerName="posmanagement.controller.Pos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <f:DynamicPage showFooter="true"
        fitContent="true"
        class="pagePos">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{POS>/formTitle}"/>
                </f:heading>
                <f:expandedContent>
                    <Label text="{POS>/idPos}"
                        visible="{POS>/isEdit}"
                        design="Bold"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Label text="{POS>/idPos}"
                        visible="{POS>/isEdit}"
                        design="Bold"/>
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <!-- CONTENT: form POS + tabella utenti + colonna abilitazioni -->
        <f:content>
            <VBox>

                <!-- FORM POS (ex testata) -->
                <Panel>
                    <form:Form id="frmPosEdit"
                        editable="true">
                        <form:layout>
                            <form:ResponsiveGridLayout labelSpanXL="4"
                                labelSpanL="4"
                                labelSpanM="4"
                                labelSpanS="12"
                                adjustLabelSpan="false"
                                emptySpanXL="0"
                                emptySpanL="0"
                                emptySpanM="0"
                                emptySpanS="0"
                                columnsXL="3"
                                columnsL="3"
                                columnsM="2"
                                singleContainerFullSize="false"/>
                        </form:layout>
                        <form:formContainers>

                            <!-- Container 1: Identificatori -->
                            <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement label="{i18n>lblContract}">
                                        <form:fields>
                                            <Input id="inpContractCode"
                                                value="{POS>/contratto}"
                                                editable="{= !${POS>/isEdit} }"
                                                showValueHelp="{= !${POS>/isEdit} }"
                                                valueHelpRequest=".onContractValueHelp"
                                                maxLength="50" />
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblContractorCompany}">
                                        <form:fields>
                                            <Input id="inpContractorCompany"
                                                value="{POS>/impresaAppaltatrice}"
                                                showValueHelp="true"
                                                valueHelpRequest=".onImpresaValueHelp"
                                                editable="false"
                                                maxLength="150" />
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblCompanyRole}">
                                        <form:fields>
                                            <ComboBox id="selCompanyRole"
                                                selectedKey="{POS>/ruoloImpresa}"
                                                items="{path: 'CompanyRole>/', templateShareable: false}">
                                                <core:Item key="{CompanyRole>key}"
                                                    text="{CompanyRole>text}"/>
                                            </ComboBox>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblEmployer}">
                                        <form:fields>
                                            <Input id="inpEmployer"
                                                value="{POS>/datoreLavoro}"
                                                required="true"
                                                maxLength="100"/>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblRspp}">
                                        <form:fields>
                                            <Input id="inpRspp"
                                                value="{POS>/rspp}"
                                                maxLength="100"/>
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer>

                            <!-- Container 2: Figure di sicurezza -->
                            <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement label="{i18n>lblRls}">
                                        <form:fields>
                                            <Input id="inpRls"
                                                value="{POS>/rls}"
                                                required="true"
                                                maxLength="100"/>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblMedicoCompetente}">
                                        <form:fields>
                                            <Input id="inpMedicoCompetente"
                                                value="{POS>/medicocompetente}"
                                                required="true"
                                                maxLength="100"/>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblWorksDirectorSite}">
                                        <form:fields>
                                            <Input id="inpWorksDirectorSite"
                                                value="{POS>/direttoreCantiere}"
                                                maxLength="100"/>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblSiteManager}">
                                        <form:fields>
                                            <Input id="inpSiteManager"
                                                value="{POS>/direttoreTecnico}"
                                                maxLength="100"/>
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer>

                            <!-- Container 3: date -->
                            <form:FormContainer>
                                <form:formElements>
                                    <form:FormElement label="{i18n>lblPosStatus}">
                                        <form:fields>
                                            <ComboBox id="selStatoPos"
                                                selectedKey="{POS>/statoPos}"
                                                items="{path: 'PosStatus>/', templateShareable: false}">
                                                <core:Item key="{PosStatus>key}"
                                                    text="{PosStatus>text}"/>
                                            </ComboBox>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblRevision}">
                                        <form:fields>
                                            <Input id="inpRevision"
                                                value="{POS>/revisione}"
                                                maxLength="6"/>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblDraftDate}">
                                        <form:fields>
                                            <DatePicker id="dpDraftDate"
                                                value="{POS>/dataRedazione}"
                                                valueFormat="yyyy-MM-dd"
                                                displayFormat="dd/MM/yyyy"/>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblReceptionDate}">
                                        <form:fields>
                                            <DatePicker id="dpReceptionDate"
                                                value="{POS>/dataRicezioneCruscotto}"
                                                valueFormat="yyyy-MM-dd"
                                                displayFormat="dd/MM/yyyy"/>
                                        </form:fields>
                                    </form:FormElement>
                                    <form:FormElement label="{i18n>lblLink}">
                                        <form:fields>
                                            <Input id="inpLink"
                                                value="{POS>/linkCde}"
                                                maxLength="1000"/>
                                        </form:fields>
                                    </form:FormElement>
                                </form:formElements>
                            </form:FormContainer>

                        </form:formContainers>
                    </form:Form>
                </Panel>

                <!-- tabella utenti + colonna abilitazioni -->
                <f:FlexibleColumnLayout id="fclStaff"
                    class="fclStaff"
                    layout="{= ${Skills>/isOpen} ? 'TwoColumnsBeginExpanded' : 'OneColumn' }">

                    <!-- Colonna master: tabella utenti -->
                    <f:beginColumnPages>
                        <Page showHeader="false"
                            enableScrolling="true">
                            <content>
                                <Panel>
                                    <headerToolbar>
                                        <OverflowToolbar style="Standard">
                                            <Title text="{i18n>lblEmployees} ({Staff>/count})"
                                                level="H2"/>
                                            <ToolbarSpacer/>
                                            <SearchField search=".onSearchStaff"
                                                width="24rem"/>
                                            <Button icon="sap-icon://add"
                                                text="{i18n>btnAdd}"
                                                press=".onAddStaff"/>
                                            <Button icon="sap-icon://action-settings"
                                                press=".onSettings"
                                                tooltip="{i18n>btnSettings}"
                                                app:panel="Columns"/>
                                            <Button icon="sap-icon://download"
                                                press=".onDownload"
                                                tooltip="{i18n>btnDownload}"/>
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <Table id="tblStaff"
                                        items="{Staff>/data}"
                                        mode="None"
                                        fixedLayout="true"
                                        alternateRowColors="true"
                                        sticky="ColumnHeaders"
                                        growing="true"
                                        growingThreshold="5">

                                        <columns>

                                            <Column app:p13nKey="idDipendente"
                                                width="9rem"
                                                visible="false">
                                                <header>
                                                    <Label text="{i18n>lblEmployeeId}"
                                                        wrapping="false"/>
                                                </header>
                                            </Column>

                                            <Column app:p13nKey="nome"
                                                width="10rem">
                                                <header>
                                                    <Label id="lblFirstNameStaff" text="{i18n>lblFirstName}"
                                                        wrapping="false"/>
                                                </header>
                                            </Column>

                                            <Column app:p13nKey="cognome"
                                                width="10rem">
                                                <header>
                                                    <Label id="lblLastNameStaff" text="{i18n>lblLastName}"
                                                        wrapping="false"/>
                                                </header>
                                            </Column>

                                            <Column app:p13nKey="reparto"
                                                width="12rem">
                                                <header>
                                                    <Label id="lblDepartmentStaff" text="{i18n>lblDepartment}"
                                                        wrapping="false"/>
                                                </header>
                                            </Column>

                                            <Column app:p13nKey="mansione"
                                                width="10rem">
                                                <header>
                                                    <Label id="lblRoleStaff" text="{i18n>lblRole}"
                                                        wrapping="false"/>
                                                </header>
                                            </Column>

                                            <Column width="6rem"
                                                hAlign="Center">
                                                <header>
                                                    <Label text=""/>
                                                </header>
                                            </Column>

                                        </columns>

                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Text text="{Staff>idDipendente}"
                                                        wrapping="false"/>
                                                    <Input value="{Staff>nome}"
                                                        maxLength="50"
                                                        ariaLabelledBy="lblFirstNameStaff"/>
                                                    <Input value="{Staff>cognome}"
                                                        maxLength="50"
                                                        ariaLabelledBy="lblLastNameStaff"/>
                                                    <Input value="{Staff>reparto}"
                                                        maxLength="50"
                                                        required="true"
                                                        ariaLabelledBy="lblDepartmentStaff"/>
                                                    <Input value="{Staff>mansione}"
                                                        maxLength="50"
                                                        ariaLabelledBy="lblRoleStaff"/>
                                                    <HBox>
                                                        <Button icon="sap-icon://permission"
                                                            type="Transparent"
                                                            press=".onOpenSkills"
                                                            tooltip="{i18n>btnSkills}"/>
                                                        <Button icon="sap-icon://delete"
                                                            type="Transparent"
                                                            press=".onDeleteStaff"
                                                            tooltip="{i18n>btnDelete}"/>
                                                    </HBox>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </Panel>
                            </content>
                        </Page>
                    </f:beginColumnPages>

                    <!-- Colonna detail: abilitazioni dipendente -->
                    <f:midColumnPages>
                        <Page title="{= ${i18n>lblSkills} + ' - ' + ${Skills>/nome} + ' ' + ${Skills>/cognome} }"
                            showNavButton="true"
                            navButtonPress=".onCloseSkills">
                            <content>
                                <VBox class="skillsPanel">

                                    <IconTabBar id="tabSkills"
                                        expanded="true">
                                        <items>

                                            <!-- Tab 1: Abilitazioni Ferroviarie -->
                                            <IconTabFilter text="{i18n>lblTabFerroviaria}"
                                                key="ferroviaria">
                                                <Panel>
                                                    <headerToolbar>
                                                        <OverflowToolbar style="Standard">
                                                            <Title text="{i18n>lblTabFerroviaria}"
                                                                level="H2"/>
                                                            <ToolbarSpacer/>
                                                        </OverflowToolbar>
                                                    </headerToolbar>
                                                    <Table id="tblFerroviaria"
                                                        items="{path: 'Skills>/items', filters: [{path: 'categoria', operator: 'EQ', value1: 'ferroviaria'}]}"
                                                        mode="MultiSelect"
                                                        selectionChange=".onSkillSelectionChange"
                                                        fixedLayout="false">
                                                        <columns>
                                                            <Column>
                                                                <header>
                                                                    <Label text="{i18n>lblSkills}"/>
                                                                </header>
                                                            </Column>
                                                            <Column width="10rem">
                                                                <header>
                                                                    <Label id="lblSkillStartFerroviaria" text="{i18n>lblSkillStart}"/>
                                                                </header>
                                                            </Column>
                                                            <Column width="10rem">
                                                                <header>
                                                                    <Label id="lblSkillEndFerroviaria" text="{i18n>lblSkillEnd}"/>
                                                                </header>
                                                            </Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem selected="{Skills>flagAttiva}"
                                                                type="Inactive">
                                                                <cells>
                                                                    <Text text="{Skills>descrizione}"
                                                                        wrapping="false"/>
                                                                    <DatePicker value="{Skills>inizioAbilitazione}"
                                                                        valueFormat="yyyy-MM-dd"
                                                                        displayFormat="dd/MM/yyyy"
                                                                        visible="{Skills>flagAttiva}"
                                                                        width="9rem"
                                                                        change=".onSkillDateChange"
                                                                        ariaLabelledBy="lblSkillStartFerroviaria"/>
                                                                    <DatePicker value="{Skills>scadenzaAbilitazione}"
                                                                        valueFormat="yyyy-MM-dd"
                                                                        displayFormat="dd/MM/yyyy"
                                                                        visible="{Skills>flagAttiva}"
                                                                        width="9rem"
                                                                        change=".onSkillDateChange"
                                                                        ariaLabelledBy="lblSkillEndFerroviaria"/>
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>
                                                </Panel>
                                            </IconTabFilter>

                                            <!-- Tab 2: Decreto 81/2008 -->
                                            <IconTabFilter text="{i18n>lblTabDecreto}"
                                                key="decreto">
                                                <Panel>
                                                    <headerToolbar>
                                                        <OverflowToolbar style="Standard">
                                                            <Title text="{i18n>lblTabDecreto}"
                                                                level="H2"/>
                                                            <ToolbarSpacer/>
                                                        </OverflowToolbar>
                                                    </headerToolbar>
                                                    <Table id="tblDecreto"
                                                        items="{path: 'Skills>/items', filters: [{path: 'categoria', operator: 'EQ', value1: 'decreto'}]}"
                                                        mode="MultiSelect"
                                                        selectionChange=".onSkillSelectionChange"
                                                        fixedLayout="false">
                                                        <columns>
                                                            <Column>
                                                                <header>
                                                                    <Label text="{i18n>lblSkills}"/>
                                                                </header>
                                                            </Column>
                                                            <Column width="10rem">
                                                                <header>
                                                                    <Label id="lblSkillStartDecreto" text="{i18n>lblSkillStart}"/>
                                                                </header>
                                                            </Column>
                                                            <Column width="10rem">
                                                                <header>
                                                                    <Label id="lblSkillEndDecreto" text="{i18n>lblSkillEnd}"/>
                                                                </header>
                                                            </Column>
                                                        </columns>
                                                        <items>
                                                            <ColumnListItem selected="{Skills>flagAttiva}"
                                                                type="Inactive">
                                                                <cells>
                                                                    <Text text="{Skills>descrizione}"
                                                                        wrapping="false"/>
                                                                    <DatePicker value="{Skills>inizioAbilitazione}"
                                                                        valueFormat="yyyy-MM-dd"
                                                                        displayFormat="dd/MM/yyyy"
                                                                        visible="{Skills>flagAttiva}"
                                                                        width="9rem"
                                                                        change=".onSkillDateChange"
                                                                        ariaLabelledBy="lblSkillStartDecreto"/>
                                                                    <DatePicker value="{Skills>scadenzaAbilitazione}"
                                                                        valueFormat="yyyy-MM-dd"
                                                                        displayFormat="dd/MM/yyyy"
                                                                        visible="{Skills>flagAttiva}"
                                                                        width="9rem"
                                                                        change=".onSkillDateChange"
                                                                        ariaLabelledBy="lblSkillEndDecreto"/>
                                                                </cells>
                                                            </ColumnListItem>
                                                        </items>
                                                    </Table>
                                                </Panel>
                                            </IconTabFilter>

                                        </items>
                                    </IconTabBar>

                                </VBox>
                            </content>
                        </Page>
                    </f:midColumnPages>

                </f:FlexibleColumnLayout>

            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <Button text="{i18n>btnBack}"
                    icon="sap-icon://nav-back"
                    press=".onBack"
                    type="Transparent"
                    visible="{POS>/isEdit}"/>
                <ToolbarSpacer/>
                <Button id="btnSave"
                    text="{i18n>btnSave}"
                    type="Emphasized"
                    icon="sap-icon://save"
                    press=".onSave"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>

</mvc:View>
