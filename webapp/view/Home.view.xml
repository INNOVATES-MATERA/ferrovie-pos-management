<mvc:View controllerName="posmanagement.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <f:DynamicPage showFooter="false"
        class="pageHome">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>menuHome}"/>
                </f:heading>
                <f:actions>
                    <Button text="{i18n>btnNewPos}"
                        type="Emphasized"
                        icon="sap-icon://add"
                        press=".onNewPos"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>

                <!-- CARDS -->
                <HBox wrap="Wrap"
                    class="sapUiSmallMarginBottom">
                    <f:Card class="sapUiTinyMargin pos-stat-card"
                        width="20rem">
                        <f:header>
                            <card:NumericHeader title="{i18n>cardPosInserted}"
                                number="{Dashboard>/posInserted}"/>
                        </f:header>
                    </f:Card>
                    <f:Card class="sapUiTinyMargin pos-stat-card"
                        width="20rem">
                        <f:header>
                            <card:NumericHeader title="{i18n>cardPosToInsert}"
                                number="{Dashboard>/posToInsert}"/>
                        </f:header>
                    </f:Card>
                    <f:Card class="sapUiTinyMargin pos-stat-card"
                        width="20rem">
                        <f:header>
                            <card:NumericHeader title="{i18n>cardPosScaduti}"
                                number="{Dashboard>/posScaduti}"/>
                        </f:header>
                    </f:Card>
                    <f:Card class="sapUiTinyMargin pos-stat-card"
                        width="20rem">
                        <f:header>
                            <card:NumericHeader title="{i18n>cardPosSuperati}"
                                number="{Dashboard>/posSuperati}"/>
                        </f:header>
                    </f:Card>
                </HBox>

                <!-- ULTIMI POS AGGIORNATI -->
                <Panel class="sapUiTinyMarginTop">
                    <headerToolbar>
                        <OverflowToolbar style="Standard">
                            <Title text="{i18n>lblLatestPos}"
                                level="H2"/>
                            <ToolbarSpacer/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <Table id="tblLatestPos"
                        items="{path: '/PosTestataSet', parameters: {$count: true, $orderby: 'modifiedAt desc', $select: 'idPos,contratto,impresaAppaltatrice,ruoloImpresa,statoPos,dataRedazione,modifiedAt'}, length: 5}"
                        mode="None"
                        fixedLayout="true"
                        alternateRowColors="true"
                        growing="false">

                        <columns>
                            <Column app:p13nKey="contratto"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lblContractCode}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="impresaAppaltatrice"
                                width="15rem">
                                <header>
                                    <Label text="{i18n>lblContractorCompany}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="ruoloImpresa"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lblCompanyRole}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="statoPos"
                                width="8rem">
                                <header>
                                    <Label text="{i18n>lblPosStatus}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="dataRedazione"
                                width="9rem">
                                <header>
                                    <Label text="{i18n>lblDraftDate}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="modifiedAt"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lblModifiedAt}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem press=".onOpenPos"
                                type="Navigation">
                                <cells>
                                    <Text text="{contratto}"
                                        wrapping="false"/>
                                    <Text text="{impresaAppaltatrice}"
                                        wrapping="false"/>
                                    <Text text="{ruoloImpresa}"
                                        wrapping="false"/>
                                    <ObjectStatus text="{statoPos}"
                                        state="{= ${statoPos} === 'Valido' ? 'Success' : ${statoPos} === 'Scaduto' ? 'Error' : ${statoPos} === 'Superato' ? 'Warning' : 'None' }"/>
                                    <Text core:require="{ ODataDate: 'sap/ui/model/odata/type/Date' }"
                                        text="{path: 'dataRedazione', type: 'ODataDate', formatOptions: {style: 'short', pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text text="{path: 'modifiedAt', formatter: '.dateUtils.formatDateTimeOffsetToDDMMYYYY'}"
                                        wrapping="false"/>
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </Panel>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
