<mvc:View controllerName="posmanagement.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <f:DynamicPage showFooter="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>menu_home}"/>
                </f:heading>
                <f:actions>
                    <Button text="{i18n>btn_new_pos}"
                        type="Emphasized"
                        icon="sap-icon://add"
                        press="onNewPos"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>

                <!-- CARDS -->
                <HBox wrap="Wrap"
                    class="sapUiSmallMarginBottom">
                    <f:Card class="sapUiTinyMargin pos-stat-card"
                        width="20rem">
                        <f:header>
                            <card:NumericHeader title="{i18n>card_pos_inserted}"
                                number="{Dashboard>/posInserted}"/>
                        </f:header>
                    </f:Card>
                    <f:Card class="sapUiTinyMargin pos-stat-card"
                        width="20rem">
                        <f:header>
                            <card:NumericHeader title="{i18n>card_pos_to_insert}"
                                number="{Dashboard>/posToInsert}"/>
                        </f:header>
                    </f:Card>
                </HBox>

                <!-- ULTIMI POS AGGIORNATI -->
                <Panel class="sapUiTinyMarginTop tablePanelContent">
                    <headerToolbar>
                        <OverflowToolbar style="Standard">
                            <Title text="{i18n>lbl_latest_pos}"
                                level="H2"/>
                            <ToolbarSpacer/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <Table id="tblLatestPos"
                        items="{path: '/PosTestataSet', parameters: {$count: true, $orderby: 'createdAt desc', $select: 'idPos,contratto,impresaAppaltatrice,ruoloImpresa,statoPos,dataRedazione,createdAt'}, length: 5}"
                        mode="None"
                        fixedLayout="true"
                        growing="false"
                        class="posTable">

                        <columns>
                            <Column app:p13nKey="contratto"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lbl_contract_code}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="impresaAppaltatrice"
                                width="15rem">
                                <header>
                                    <Label text="{i18n>lbl_contractor_company}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="ruoloImpresa"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lbl_company_role}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="statoPos"
                                width="8rem">
                                <header>
                                    <Label text="{i18n>lbl_pos_status}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="dataRedazione"
                                width="9rem">
                                <header>
                                    <Label text="{i18n>lbl_draft_date}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                            <Column app:p13nKey="createdAt"
                                width="10rem">
                                <header>
                                    <Label text="{i18n>lbl_created_at}"
                                        wrapping="false"/>
                                </header>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem press="onOpenPos"
                                type="Navigation">
                                <cells>
                                    <Text text="{contratto}"
                                        wrapping="false"/>
                                    <Text text="{impresaAppaltatrice}"
                                        wrapping="false"/>
                                    <Text text="{ruoloImpresa}"
                                        wrapping="false"/>
                                    <ObjectStatus text="{statoPos}" class="posStatusBadge">
                                        <customData>
                                            <core:CustomData key="stato" value="{statoPos}" writeToDom="true"/>
                                        </customData>
                                    </ObjectStatus>
                                    <Text text="{path: 'dataRedazione', type: 'sap.ui.model.odata.type.Date', formatOptions: {style: 'short', pattern: 'dd/MM/yyyy'}}"
                                        wrapping="false"/>
                                    <Text text="{path: 'createdAt', formatter: '.dateUtils.formatDateTimeOffsetToDDMMYYYY'}"
                                        wrapping="false"/>
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>
                </Panel>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
