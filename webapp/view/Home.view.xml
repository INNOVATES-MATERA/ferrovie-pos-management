<mvc:View controllerName="posmanagement.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:sap.ui.fl="sap.ui.fl"
    xmlns:rowmodes="sap.ui.table.rowmodes">

    <f:DynamicPage showFooter="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>title}"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:content>
            <VBox>

                <!-- FILTRI -->
                <Panel>
                    <l:Grid>
                        <VBox>
                            <Label text="{i18n>lbl_search_home}"/>
                            <SearchField id="sfPos"
                                change="onFiltersChange"
                                value="{Pos>/filters/qFilter}"
                                placeholder="{i18n>plh_search}"/>
                            <layoutData>
                                <l:GridData span="XL4 L5 M6 S12"/>
                            </layoutData>
                        </VBox>

                        <HBox justifyContent="End">
                            <VBox class="sapUiTinyMarginEnd">
                                <Label text=""/>
                                <Button id="btnReset"
                                    text="{i18n>btn_reset}"
                                    icon="sap-icon://refresh"
                                    press="onReset"/>
                            </VBox>
                            <layoutData>
                                <l:GridData span="XL2 L3 M6 S12"
                                    indent="XL6 L4 M6"/>
                            </layoutData>
                        </HBox>
                    </l:Grid>
                </Panel>

                <!-- TABELLA -->
                <Panel class="sapUiTinyMarginTop">
                    <OverflowToolbar style="Standard"
                        class="p-0">
                        <Label text="{i18n>lbl_extracted_records}: {Pos>/count}"
                            design="Bold"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://sort"
                            press="onSettings"
                            app:panel="Sorter"/>
                        <Button icon="sap-icon://filter"
                            press="onSettings"
                            app:panel="Filter"/>
                        <Button icon="sap-icon://action-settings"
                            press="onSettings"
                            app:panel="Columns"/>
                        <Button icon="sap-icon://download"
                            press="onDownload"/>
                    </OverflowToolbar>

                    <t:Table id="tblPos"
                        rows="{/Contratti}"
                        selectionMode="Single"
                        selectionBehavior="RowOnly"
                        sap.ui.fl:flexibility="sap/m/flexibility/EngineFlex">
                        <t:rowMode>
                            <rowmodes:Fixed rowCount="15"/>
                        </t:rowMode>

                        <t:columns>

                            <t:Column app:p13nKey="codiceAtto">
                                <Label text="{i18n>lbl_act_code}"/>
                                <t:template>
                                    <Text text="{codiceAtto}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="codiceContratto">
                                <Label text="{i18n>lbl_contract_code}"/>
                                <t:template>
                                    <Text text="{codiceContratto}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="titoloDelContratto">
                                <Label text="{i18n>lbl_contract_title}"/>
                                <t:template>
                                    <Text text="{titoloDelContratto}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="oggettoDelContratto">
                                <Label text="{i18n>lbl_contract_object}"/>
                                <t:template>
                                    <Text text="{oggettoDelContratto}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="tipoDiContratto">
                                <Label text="{i18n>lbl_contract_type}"/>
                                <t:template>
                                    <Text text="{tipoDiContratto}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="tipologiaAppalto">
                                <Label text="{i18n>lbl_tender_type}"/>
                                <t:template>
                                    <Text text="{tipologiaAppalto}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="codiceNPP">
                                <Label text="{i18n>lbl_npp_code}"/>
                                <t:template>
                                    <Text text="{codiceNPP}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="descrizioneNPP">
                                <Label text="{i18n>lbl_npp_description}"/>
                                <t:template>
                                    <Text text="{descrizioneNPP}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="CUP">
                                <Label text="{i18n>lbl_cup}"/>
                                <t:template>
                                    <Text text="{CUP}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="CIGDerivato">
                                <Label text="{i18n>lbl_derived_cig}"/>
                                <t:template>
                                    <Text text="{CIGDerivato}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="stato">
                                <Label text="{i18n>lbl_status}"/>
                                <t:template>
                                    <Text text="{stato}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="documentoDiChiusuraContratto">
                                <Label text="{i18n>lbl_closure_document}"/>
                                <t:template>
                                    <Text text="{documentoDiChiusuraContratto}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="numCel"
                                visible="false">
                                <Label text="{i18n>lbl_cell_number}"/>
                                <t:template>
                                    <Text text="{numCel}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="codiceSAPOrganizzazioneAcquisti"
                                visible="false">
                                <Label text="{i18n>lbl_sap_purchase_org_code}"/>
                                <t:template>
                                    <Text text="{codiceSAPOrganizzazioneAcquisti}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="descrizioneSAPOrganizzazioneAcquisti"
                                visible="false">
                                <Label text="{i18n>lbl_sap_purchase_org_desc}"/>
                                <t:template>
                                    <Text text="{descrizioneSAPOrganizzazioneAcquisti}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="codiceSAPGruppoAcquisti"
                                visible="false">
                                <Label text="{i18n>lbl_sap_purchase_group_code}"/>
                                <t:template>
                                    <Text text="{codiceSAPGruppoAcquisti}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="descrizioneSAPGruppoAcquisti"
                                visible="false">
                                <Label text="{i18n>lbl_sap_purchase_group_desc}"/>
                                <t:template>
                                    <Text text="{descrizioneSAPGruppoAcquisti}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="responsabilitaSoggettoTecnico"
                                visible="false">
                                <Label text="{i18n>lbl_technical_subject_responsibility}"/>
                                <t:template>
                                    <Text text="{responsabilitaSoggettoTecnico}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="categoriaInventariale"
                                visible="false">
                                <Label text="{i18n>lbl_inventory_category}"/>
                                <t:template>
                                    <Text text="{categoriaInventariale}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="sedeTecnica"
                                visible="false">
                                <Label text="{i18n>lbl_technical_site}"/>
                                <t:template>
                                    <Text text="{sedeTecnica}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="strutturaTitolareAsset"
                                visible="false">
                                <Label text="{i18n>lbl_asset_owner_structure}"/>
                                <t:template>
                                    <Text text="{strutturaTitolareAsset}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="createdAt"
                                visible="false">
                                <Label text="{i18n>lbl_created_at}"/>
                                <t:template>
                                    <Text text="{path: 'createdAt', formatter: '.dateUtils.formatISOtoDDMMYYYY_HHMMSS'}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="createdBy"
                                visible="false">
                                <Label text="{i18n>lbl_created_by}"/>
                                <t:template>
                                    <Text text="{createdBy}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="modifiedAt"
                                visible="false">
                                <Label text="{i18n>lbl_modified_at}"/>
                                <t:template>
                                    <Text text="{path: 'modifiedAt', formatter: '.dateUtils.formatISOtoDDMMYYYY_HHMMSS'}"/>
                                </t:template>
                            </t:Column>

                            <t:Column app:p13nKey="modifiedBy"
                                visible="false">
                                <Label text="{i18n>lbl_modified_by}"/>
                                <t:template>
                                    <Text text="{modifiedBy}"/>
                                </t:template>
                            </t:Column>

                            <!-- ACTION: solo navigazione, nessun edit -->
                            <t:Column hAlign="Center"
                                width="3.5rem">
                                <Label text=""/>
                                <t:template>
                                    <Button icon="sap-icon://navigation-right-arrow"
                                        type="Transparent"
                                        press="onDetail"
                                        tooltip="{i18n>btn_show_detail}"/>
                                </t:template>
                            </t:Column>

                        </t:columns>
                    </t:Table>
                </Panel>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
