<mvc:View controllerName="posmanagement.controller.Contract"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:sap.ui.fl="sap.ui.fl">

    <f:DynamicPage showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>lbl_contract}"/>
                </f:heading>
                <f:expandedContent>
                    <Title text="{Contract>/contractCode} - {Contract>/contractTitle}"
                        level="H3"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Title text="{Contract>/contractCode} - {Contract>/contractTitle}"
                        level="H3"/>
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <l:HorizontalLayout class="w-100"
                    allowWrapping="true">

                    <!-- Colonna 1 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_contract_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_contract_title}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractTitle}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_inventory_category}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/inventoryCategory}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_contract_type}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractType}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_tender_type}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/tenderType}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_contract_object}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractObject}"/>
                        </HBox>
                    </l:VerticalLayout>

                    <!-- Colonna 2 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_npp_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/nppCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_npp_description}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/nppDescription}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_cup}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/cup}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_derived_cig}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/derivedCig}"/>
                        </HBox>
                    </l:VerticalLayout>

                    <!-- Colonna 3 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_status}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/status}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_closure_document}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/closureDocument}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_cell_number}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/cellNumber}"/>
                        </HBox>
                    </l:VerticalLayout>

                    <!-- Colonna 4 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_group_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseGroupCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_group_desc}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseGroupDesc}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_org_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseOrgCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_org_desc}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseOrgDesc}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_technical_subject_responsibility}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/technicalSubjectResponsibility}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_technical_site}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/technicalSite}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_asset_owner_structure}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/assetOwnerStructure}"/>
                        </HBox>
                    </l:VerticalLayout>

                </l:HorizontalLayout>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>

                <!-- TABELLA POS -->
                <Panel class="sapUiTinyMarginTop">
                    <OverflowToolbar style="Standard"
                        class="p-0">
                        <Title text="{i18n>lbl_pos_table} ({Pos>/count})"
                            level="H2"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://create"
                            text="{i18n>btn_create}"
                            press="onCreate"/>
                        <Button icon="sap-icon://delete"
                            text="{i18n>btn_delete}"
                            press="onDelete"/>
                        <Button id="btnContractReset"
                            icon="sap-icon://refresh"
                            press="onReset"
                            tooltip="{i18n>btn_reset}"/>
                        <Button icon="sap-icon://sort"
                            press="onSettings"
                            tooltip="{i18n>btn_sort}"
                            app:panel="Sorter"/>
                        <Button icon="sap-icon://filter"
                            press="onSettings"
                            app:panel="Filter"/>
                        <Button icon="sap-icon://action-settings"
                            press="onSettings"
                            app:panel="Columns"/>
                        <Button icon="sap-icon://download"
                            press="onDownload"/>
                    </OverflowToolbar>

                    <ScrollContainer horizontal="true"
                        vertical="false"
                        width="100%">
                        <Table id="tblContract"
                            items="{path: 'Pos>/data'}"
                            mode="MultiSelect"
                            fixedLayout="true"
                            growing="true"
                            growingThreshold="10"
                            class="posTable">

                            <columns>

                                <Column app:p13nKey="posId"
                                    width="8rem">
                                    <header>
                                        <Label text="{i18n>lbl_pos_id}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="contractCode"
                                    width="10rem">
                                    <header>
                                        <Label text="{i18n>lbl_contract_code}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="contractorCompany"
                                    width="15rem">
                                    <header>
                                        <Label text="{i18n>lbl_contractor_company}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="companyRole"
                                    width="10rem">
                                    <header>
                                        <Label text="{i18n>lbl_company_role}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="status"
                                    width="7rem">
                                    <header>
                                        <Label text="{i18n>lbl_status}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="revision"
                                    width="6rem">
                                    <header>
                                        <Label text="{i18n>lbl_revision}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="draftDate"
                                    width="8rem">
                                    <header>
                                        <Label text="{i18n>lbl_draft_date}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="validityStart"
                                    width="8rem">
                                    <header>
                                        <Label text="{i18n>lbl_validity_start}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="validityEnd"
                                    width="8rem">
                                    <header>
                                        <Label text="{i18n>lbl_validity_end}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="parentContractCode"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_parent_contract_code}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="client"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_client}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="employer"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_employer}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="rspp"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_rspp}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="rls"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_rls}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="worksDirector"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_works_director}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="firstAidPersonnel"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_first_aid_personnel}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="firePersonnel"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_fire_personnel}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="receptionDate"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_reception_date}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="link"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_link}"
                                            wrapping="false"/>
                                    </header>
                                </Column>


                            </columns>

                            <items>
                                <ColumnListItem press="onDetail"
                                    type="Navigation">
                                    <cells>
                                        <Text text="{Pos>posId}"
                                            wrapping="false"/>
                                        <Text text="{Pos>contractCode}"
                                            wrapping="false"/>
                                        <Text text="{Pos>contractorCompany}"
                                            wrapping="false"/>
                                        <Text text="{Pos>companyRole}"
                                            wrapping="false"/>
                                        <Text text="{Pos>status}"
                                            wrapping="false"/>
                                        <Text text="{Pos>revision}"
                                            wrapping="false"/>
                                        <Text text="{path: 'Pos>draftDate', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{path: 'Pos>validityStart', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{path: 'Pos>validityEnd', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{Pos>parentContractCode}"
                                            wrapping="false"/>
                                        <Text text="{Pos>client}"
                                            wrapping="false"/>
                                        <Text text="{Pos>employer}"
                                            wrapping="false"/>
                                        <Text text="{Pos>rspp}"
                                            wrapping="false"/>
                                        <Text text="{Pos>rls}"
                                            wrapping="false"/>
                                        <Text text="{Pos>worksDirector}"
                                            wrapping="false"/>
                                        <Text text="{Pos>firstAidPersonnel}"
                                            wrapping="false"/>
                                        <Text text="{Pos>firePersonnel}"
                                            wrapping="false"/>
                                        <Text text="{path: 'Pos>receptionDate', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{Pos>link}"
                                            wrapping="false"/>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                    </ScrollContainer>
                </Panel>

            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <Button text="{i18n>btn_back}"
                    type="Back"
                    press="onBack"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
