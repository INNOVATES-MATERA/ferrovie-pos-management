<mvc:View controllerName="posmanagement.controller.Contract"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:sap.ui.fl="sap.ui.fl">

    <f:DynamicPage showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>lbl_contract}"/>
                </f:heading>
                <f:expandedContent>
                    <Title text="{Contract>/contractCode} - {Contract>/contractTitle}"
                        level="H3"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Title text="{Contract>/contractCode} - {Contract>/contractTitle}"
                        level="H3"/>
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <l:HorizontalLayout class="w-100"
                    allowWrapping="true">

                    <!-- Colonna 1 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_contract_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_contract_title}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractTitle}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_inventory_category}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/inventoryCategory}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_contract_type}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractType}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_tender_type}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/tenderType}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_contract_object}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/contractObject}"/>
                        </HBox>
                    </l:VerticalLayout>

                    <!-- Colonna 2 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_npp_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/nppCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_npp_description}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/nppDescription}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_cup}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/cup}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_derived_cig}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/derivedCig}"/>
                        </HBox>
                    </l:VerticalLayout>

                    <!-- Colonna 3 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_status}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/status}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_closure_document}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/closureDocument}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_cell_number}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/cellNumber}"/>
                        </HBox>
                    </l:VerticalLayout>

                    <!-- Colonna 4 -->
                    <l:VerticalLayout class="vertical-layout-responsive sapUiTinyMarginEnd">
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_group_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseGroupCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_group_desc}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseGroupDesc}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_org_code}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseOrgCode}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_sap_purchase_org_desc}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/sapPurchaseOrgDesc}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_technical_subject_responsibility}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/technicalSubjectResponsibility}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_technical_site}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/technicalSite}"/>
                        </HBox>
                        <HBox>
                            <Label text="{i18n>lbl_asset_owner_structure}"
                                showColon="true"
                                class="m-label-hbox"/>
                            <Text text="{Contract>/assetOwnerStructure}"/>
                        </HBox>
                    </l:VerticalLayout>

                </l:HorizontalLayout>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>

                <!-- TABELLA POS -->
                <Panel class="sapUiTinyMarginTop">
                    <OverflowToolbar style="Standard"
                        class="pt-auto-10">
                        <Title text="{i18n>lbl_pos_table} ({Pos>/count})"
                            level="H2"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://create"
                            text="{i18n>btn_create}"
                            press="onCreate"/>
                        <Button icon="sap-icon://delete"
                            text="{i18n>btn_delete}"
                            press="onDelete"/>
                        <Button id="btnContractReset"
                            icon="sap-icon://refresh"
                            press="onReset"
                            tooltip="{i18n>btn_reset}"/>
                        <Button icon="sap-icon://sort"
                            press="onSettings"
                            tooltip="{i18n>btn_sort}"
                            app:panel="Sorter">
                            <customData>
                                <BadgeCustomData value="{Pos>/sortCount}"/>
                            </customData>
                        </Button>
                        <Button icon="sap-icon://filter"
                            press="onSettings"
                            app:panel="Filter">
                            <customData>
                                <BadgeCustomData value="{Pos>/filterCount}"/>
                            </customData>
                        </Button>
                        <Button icon="sap-icon://action-settings"
                            press="onSettings"
                            app:panel="Columns"/>
                        <Button icon="sap-icon://download"
                            press="onDownload"/>
                    </OverflowToolbar>

                    <ScrollContainer horizontal="true"
                        vertical="false"
                        width="100%">
                        <!-- Metto items="{__init__>/data}" perchè la tabella ha biosogno di un template -->
                        <Table id="tblContract"
                            items="{__init__>/data}"
                            mode="MultiSelect"
                            fixedLayout="true"
                            growing="true"
                            growingThreshold="10"
                            class="posTable">

                            <columns>

                                <Column app:p13nKey="idPos"
                                    width="8rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_pos_id}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="contratto"
                                    width="10rem">
                                    <header>
                                        <Label text="{i18n>lbl_contract_code}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="impresaAppaltatrice"
                                    width="15rem">
                                    <header>
                                        <Label text="{i18n>lbl_contractor_company}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="ruoloImpresa"
                                    width="10rem">
                                    <header>
                                        <Label text="{i18n>lbl_company_role}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="revisione"
                                    width="6rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_revision}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="dataRedazione"
                                    width="9rem">
                                    <header>
                                        <Label text="{i18n>lbl_draft_date}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="inizioValidita"
                                    width="8rem">
                                    <header>
                                        <Label text="{i18n>lbl_validity_start}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="fineValidita"
                                    width="8rem">
                                    <header>
                                        <Label text="{i18n>lbl_validity_end}"
                                            wrapping="false"/>
                                    </header>
                                </Column>


                                <Column app:p13nKey="codiceContrattoSuperiore"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_parent_contract_code}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="committente"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_client}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="datoreLavoro"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_employer}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="rspp"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_rspp}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="rls"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_rls}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="direttoreLavori"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_works_director}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="addettiPrimoSoccorso"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_first_aid_personnel}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="addettiPrimoAntincendio"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_fire_personnel}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="dataRicezioneCruscotto"
                                    width="10rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_reception_date}"
                                            wrapping="false"/>
                                    </header>
                                </Column>

                                <Column app:p13nKey="linkCde"
                                    width="12rem"
                                    visible="false">
                                    <header>
                                        <Label text="{i18n>lbl_link}"
                                            wrapping="false"/>
                                    </header>
                                </Column>


                            </columns>

                            <items>
                                <ColumnListItem press="onDetail"
                                    type="Navigation">
                                    <cells>
                                        <Text text="{idPos}"
                                            wrapping="false"/>
                                        <Text text="{contratto}"
                                            wrapping="false"/>
                                        <Text text="{impresaAppaltatrice}"
                                            wrapping="false"/>
                                        <Text text="{ruoloImpresa}"
                                            wrapping="false"/>
                                        <Text text="{revisione}"
                                            wrapping="false"/>
                                        <Text text="{path: 'dataRedazione', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{path: 'inizioValidita', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{path: 'fineValidita', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{codiceContrattoSuperiore}"
                                            wrapping="false"/>
                                        <Text text="{committente}"
                                            wrapping="false"/>
                                        <Text text="{datoreLavoro}"
                                            wrapping="false"/>
                                        <Text text="{rspp}"
                                            wrapping="false"/>
                                        <Text text="{rls}"
                                            wrapping="false"/>
                                        <Text text="{direttoreLavori}"
                                            wrapping="false"/>
                                        <Text text="{addettiPrimoSoccorso}"
                                            wrapping="false"/>
                                        <Text text="{addettiPrimoAntincendio}"
                                            wrapping="false"/>
                                        <Text text="{path: 'dataRicezioneCruscotto', formatter: '.dateUtils.formatYYYYMMDDtoDDMMYYYY'}"
                                            wrapping="false"/>
                                        <Text text="{linkCde}"
                                            wrapping="false"/>
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                    </ScrollContainer>
                </Panel>

            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <Button text="{i18n>btn_back}"
                    type="Back"
                    press="onBack"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
